<div style="background:#0a0a0a;border-radius:14px;padding:14px;font-family:var(--font-sans)">
<style>
#sg{--bg:#080808;--s1:#0e0e0e;--s2:#121212;--bd:#163a57;--bl:#1e4a6e;--bt:#5ba3d0;--tx:#cfcfcf;--mut:#5a6670;--gr:#22c55e;background:var(--bg);border:1px solid var(--bd);border-radius:11px;overflow:hidden;color:var(--tx)}
#sg .top{height:38px;display:flex;align-items:center;gap:8px;padding:0 12px;background:var(--s1);border-bottom:1px solid var(--bd)}
#sg .isl{display:flex;align-items:center;gap:7px;background:var(--s2);border:1px solid var(--bl);border-radius:14px;padding:3px 11px;font-family:var(--font-mono);font-size:11px;color:var(--bt)}
#sg .dot{width:6px;height:6px;border-radius:50%;background:#2d6fa0}
#sg .wrap{display:grid;grid-template-columns:230px 1fr;gap:18px;padding:18px 20px}
#sg .stage{background:radial-gradient(circle at 50% 40%, #10161c 0%, #060809 70%);border:1px solid var(--bd);border-radius:12px;display:flex;align-items:center;justify-content:center;height:260px}
#sg .stage svg{width:180px;height:222px}
#sg .meta{margin-top:10px;font-family:var(--font-mono);font-size:10px;color:var(--mut);text-align:center;line-height:1.7}
#sg .meta b{color:var(--bt);font-weight:400}
#sg .ctrls{min-width:0}
#sg .fl{font-size:10px;font-family:var(--font-mono);color:var(--mut);text-transform:uppercase;letter-spacing:.06em;margin:0 0 6px}
#sg .seg{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
#sg .sgb{padding:6px 11px;cursor:pointer;color:var(--mut);background:var(--s1);border:1px solid var(--bd);border-radius:7px;font-family:var(--font-mono);font-size:10.5px}
#sg .sgb.on{background:var(--bl);border-color:#2d6fa0;color:var(--bt)}
#sg .tiers .sgb.on[data-t=rare]{background:#11293c;border-color:#5ba3d0;color:#7ad4ff}
#sg .tiers .sgb.on[data-t=superrare]{background:#241734;border-color:#b86fd9;color:#d9b8f5}
#sg .tiers .sgb.on[data-t=iclone]{background:#2e2410;border-color:#d9a23b;color:#ffd98a}
#sg .seedbar{display:flex;align-items:center;gap:8px;margin-bottom:14px}
#sg .sbtn{background:var(--s1);border:1px solid var(--bd);border-radius:7px;color:var(--bt);cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-size:15px}
#sg .sbtn:hover{background:var(--bl)}
#sg .seedv{flex:1;text-align:center;font-family:var(--font-mono);font-size:12px;color:var(--tx);background:var(--s1);border:1px solid var(--bd);border-radius:7px;padding:7px}
#sg .roll{background:var(--bl);border:1px solid #2d6fa0;color:var(--bt);cursor:pointer;border-radius:7px;font-family:var(--font-mono);font-size:11px;padding:0 12px;height:32px;display:flex;align-items:center;gap:6px}
#sg .roll:hover{background:#2d6fa0;color:#fff}
#sg .strip{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-bottom:16px}
#sg .v{background:#0a0e12;border:1px solid var(--bd);border-radius:8px;cursor:pointer;padding:4px;transition:border-color .12s,transform .1s}
#sg .v:hover{border-color:var(--bt);transform:translateY(-2px)}
#sg .v svg{width:100%;height:64px;display:block}
#sg .onchain{display:flex;align-items:center;gap:8px;background:#060d13;border:1px solid var(--bd);border-radius:8px;padding:9px 11px;font-family:var(--font-mono);font-size:10px;color:var(--mut);margin-bottom:14px}
#sg .onchain b{color:var(--gr);font-weight:400}
#sg .mint{width:100%;padding:11px;background:var(--bl);border:1px solid #2d6fa0;border-radius:8px;color:var(--bt);font-size:12px;font-family:var(--font-mono);letter-spacing:.04em;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px}
#sg .mint:hover{background:#2d6fa0;color:#fff}
</style>
<div id="sg">
  <div class="top"><div class="isl"><span style="color:#3a6f96">[</span> &gt; iclone / silhouette-engine <span class="dot"></span></div></div>
  <div class="wrap">
    <div>
      <div class="stage" id="sgstage"></div>
      <div class="meta" id="sgmeta"></div>
    </div>
    <div class="ctrls">
      <div class="fl">class</div>
      <div class="seg" id="sgcls"></div>
      <div class="fl">rarity tier · focal color</div>
      <div class="seg tiers" id="sgtier"></div>
      <div class="fl">seed · = token id</div>
      <div class="seedbar">
        <div class="sbtn" onclick="sgStep(-1)"><i class="ti ti-chevron-left"></i></div>
        <div class="seedv" id="sgseed">#000912</div>
        <div class="sbtn" onclick="sgStep(1)"><i class="ti ti-chevron-right"></i></div>
        <div class="roll" onclick="sgRoll()"><i class="ti ti-dice-5"></i> roll</div>
      </div>
      <div class="fl">variations</div>
      <div class="strip" id="sgstrip"></div>
      <div class="onchain"><i class="ti ti-link" style="color:var(--gr)"></i> <span><b>100% on-chain</b> · deterministic SVG → base64 data URI in tokenURI · no IPFS for art</span></div>
      <button class="mint" onclick="sgMint()"><i class="ti ti-stack-2"></i> Mint this silhouette</button>
    </div>
  </div>
</div>
<script>
(function(){
  var classes=['Shadow','Operative','Synth','Vanguard','Nullborn'];
  var tiers=[['rare','#5ba3d0','#7ad4ff'],['superrare','#b86fd9','#d9b8f5'],['iclone','#d9a23b','#ffd98a']];
  var state={cls:'Shadow',tier:'rare',seed:912};
  function mb(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
  function pick(r,arr){return arr[Math.floor(r()*arr.length)];}
  function tierOf(t){for(var i=0;i<tiers.length;i++)if(tiers[i][0]===t)return tiers[i];return tiers[1];}
  function build(seed,cls,tier){
    var ci=classes.indexOf(cls); if(ci<0)ci=0;
    var r=mb((seed*2654435761>>>0)^(ci*97)^(tier.length*131));
    var T=tierOf(tier), acc=T[1], glow=T[2];
    var d0='#0a0e12',d1='#161b21',d2='#1f262e';
    var head=pick(r,['hex','round','visor']);
    var eyes=pick(r,['slits','dots','mono']);
    var torso=pick(r,['broad','slim','armored']);
    var ant=pick(r,['none','single','horns']);
    var glyph=pick(r,['circle','tri','diamond','cross']);
    if(cls==='Shadow'){ant=r()<.6?'none':'single';eyes=r()<.6?'slits':eyes;}
    if(cls==='Vanguard'){torso='armored';}
    if(cls==='Synth'){head='round';}
    if(cls==='Nullborn'){eyes='mono';}
    var s='<svg viewBox="0 0 100 124" xmlns="http://www.w3.org/2000/svg">';
    s+='<ellipse cx="50" cy="117" rx="24" ry="4" fill="'+acc+'" opacity=".16"/>';
    if(torso==='broad')s+='<path d="M25 72 Q23 98 21 116 L79 116 Q77 98 75 72 Q62 63 50 63 Q38 63 25 72Z" fill="'+d1+'"/><path d="M36 76 Q50 82 64 76 L60 102 Q50 108 40 102Z" fill="'+d2+'"/>';
    else if(torso==='slim')s+='<path d="M33 72 Q31 98 31 116 L69 116 Q69 98 67 72 Q60 65 50 65 Q40 65 33 72Z" fill="'+d1+'"/><path d="M40 78 Q50 83 60 78 L57 104 Q50 109 43 104Z" fill="'+d2+'"/>';
    else s+='<path d="M24 73 Q23 99 22 116 L78 116 Q77 99 76 73 Q62 64 50 64 Q38 64 24 73Z" fill="'+d1+'"/><rect x="35" y="74" width="30" height="30" rx="6" fill="'+d2+'"/><line x1="50" y1="74" x2="50" y2="104" stroke="'+d0+'" stroke-width="1.5"/><line x1="35" y1="86" x2="65" y2="86" stroke="'+d0+'" stroke-width="1.5"/>';
    if(ant==='single')s+='<line x1="50" y1="16" x2="50" y2="6" stroke="'+d2+'" stroke-width="2"/><circle cx="50" cy="5" r="2.4" fill="'+acc+'"/>';
    else if(ant==='horns')s+='<path d="M34 22 L26 8 L31 9 L39 21Z" fill="'+d2+'"/><path d="M66 22 L74 8 L69 9 L61 21Z" fill="'+d2+'"/>';
    if(head==='hex')s+='<polygon points="50,16 70,28 70,48 50,60 30,48 30,28" fill="'+d2+'"/>';
    else if(head==='round')s+='<ellipse cx="50" cy="38" rx="20" ry="22" fill="'+d2+'"/>';
    else s+='<rect x="30" y="18" width="40" height="40" rx="12" fill="'+d2+'"/>';
    if(head==='visor')s+='<rect x="31" y="30" width="38" height="15" rx="5" fill="'+d0+'"/>';
    if(eyes==='slits')s+='<rect x="38" y="37" width="8" height="3.4" rx="1.7" fill="'+acc+'"/><rect x="54" y="37" width="8" height="3.4" rx="1.7" fill="'+acc+'"/>';
    else if(eyes==='dots')s+='<circle cx="42" cy="39" r="3" fill="'+glow+'"/><circle cx="58" cy="39" r="3" fill="'+glow+'"/>';
    else s+='<rect x="36" y="36" width="28" height="5" rx="2.5" fill="'+d0+'"/><rect x="38" y="37.6" width="24" height="1.8" rx=".9" fill="'+acc+'"/>';
    var gy=torso==='armored'?89:90;
    if(glyph==='circle')s+='<circle cx="50" cy="'+gy+'" r="3.4" fill="none" stroke="'+acc+'" stroke-width="1.6"/>';
    else if(glyph==='tri')s+='<polygon points="50,'+(gy-4)+' 54,'+(gy+3)+' 46,'+(gy+3)+'" fill="none" stroke="'+acc+'" stroke-width="1.4"/>';
    else if(glyph==='diamond')s+='<polygon points="50,'+(gy-4)+' 54,'+gy+' 50,'+(gy+4)+' 46,'+gy+'" fill="'+acc+'"/>';
    else s+='<line x1="50" y1="'+(gy-4)+'" x2="50" y2="'+(gy+4)+'" stroke="'+acc+'" stroke-width="1.6"/><line x1="46" y1="'+gy+'" x2="54" y2="'+gy+'" stroke="'+acc+'" stroke-width="1.6"/>';
    s+='</svg>';
    return {svg:s,head:head,eyes:eyes,torso:torso,ant:ant,glyph:glyph};
  }
  function pad(n){return ('000000'+n).slice(-6);}
  function render(){
    var a=build(state.seed,state.cls,state.tier);
    document.getElementById('sgstage').innerHTML=a.svg;
    document.getElementById('sgseed').textContent='#'+pad(state.seed);
    document.getElementById('sgmeta').innerHTML='<b>'+state.cls+'</b> · '+state.tier+'<br>head '+a.head+' · eyes '+a.eyes+' · torso '+a.torso+'<br>antenna '+a.ant+' · glyph '+a.glyph;
    var st='';for(var i=0;i<6;i++){var sd=state.seed+i;st+='<div class="v" onclick="sgSet('+sd+')">'+build(sd,state.cls,state.tier).svg+'</div>';}
    document.getElementById('sgstrip').innerHTML=st;
  }
  window.sgSet=function(sd){state.seed=sd;render();};
  window.sgStep=function(d){state.seed=Math.max(0,state.seed+d);render();};
  window.sgRoll=function(){state.seed=Math.floor(Math.random()*999999);render();};
  window.sgMint=function(){sendPrompt('Mintar a silhueta gerada — classe '+state.cls+', tier '+state.tier+', seed #'+pad(state.seed)+' (SVG on-chain base64 no tokenURI) no iCLONE FRAME');};
  document.getElementById('sgcls').innerHTML=classes.map(function(c){return '<div class="sgb'+(c===state.cls?' on':'')+'" onclick="sgCls(\''+c+'\')">'+c+'</div>';}).join('');
  document.getElementById('sgtier').innerHTML=tiers.map(function(t){return '<div class="sgb'+(t[0]===state.tier?' on':'')+'" data-t="'+t[0]+'" onclick="sgTier(\''+t[0]+'\')">'+t[0]+'</div>';}).join('');
  window.sgCls=function(c){state.cls=c;document.querySelectorAll('#sgcls .sgb').forEach(function(b){b.classList.toggle('on',b.textContent===c);});render();};
  window.sgTier=function(t){state.tier=t;document.querySelectorAll('#sgtier .sgb').forEach(function(b){b.classList.toggle('on',b.dataset.t===t);});render();};
  render();
})();
</script>
</div>
