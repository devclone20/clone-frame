<div style="background:#ffffff;border-radius:14px;padding:14px;font-family:var(--font-sans)">
<style>
#cf{--bg:#ffffff;--s1:#f4f6f8;--s2:#ffffff;--bd:#e3e7ec;--bl:#cfd4da;--bt:#4f565e;--tx:#15181c;--mut:#737b85;--am:#b8841f;--pp:#8a52c4;background:var(--bg);border:1px solid var(--bd);border-radius:11px;overflow:hidden;color:var(--tx)}
#cf.dark{--bg:#080808;--s1:#0e0e0e;--s2:#121212;--bd:#2a2e33;--bl:#3a3f45;--bt:#aab2bb;--tx:#cfcfcf;--mut:#777f88;--am:#d9a23b;--pp:#b86fd9}
#cf .top{height:38px;display:flex;align-items:center;gap:8px;padding:0 12px;background:var(--s1);border-bottom:1px solid var(--bd)}
#cf .isl{display:flex;align-items:center;gap:7px;background:var(--s2);border:1px solid var(--bl);border-radius:14px;padding:3px 11px;font-family:var(--font-mono);font-size:11px;color:var(--bt)}
#cf .dot{width:6px;height:6px;border-radius:50%;background:#aeb4bb}
#cf .modes{margin-left:auto;display:flex;gap:6px}
#cf .md{width:11px;height:11px;border-radius:50%;border:1px solid #aeb4bb;cursor:pointer}#cf .md.on{background:var(--bt);border-color:var(--bt)}
#cf .nav{display:flex;align-items:center;gap:10px;padding:11px 22px;border-bottom:1px solid var(--bd)}
#cf .brand{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.14em;color:var(--tx)}
#cf .brand b{color:var(--bt);font-weight:400}
#cf .tag{font-family:var(--font-mono);font-size:9px;letter-spacing:.06em;color:var(--mut);border:1px solid var(--bd);border-radius:6px;padding:3px 8px;display:flex;align-items:center;gap:5px}
#cf .tag i{width:5px;height:5px;border-radius:50%;background:#5a9e6f;display:inline-block}
#cf .nlinks{margin-left:auto;display:flex;gap:4px}
#cf .nl{font-family:var(--font-mono);font-size:11px;color:var(--mut);padding:6px 11px;border-radius:7px;cursor:pointer;border:1px solid transparent}
#cf .nl:hover{color:var(--tx);background:var(--s1)}
#cf .page{height:560px;overflow-y:auto;overflow-x:hidden}
#cf .page::-webkit-scrollbar{width:9px}#cf .page::-webkit-scrollbar-thumb{background:var(--bd);border-radius:5px;border:2px solid var(--bg)}#cf .page::-webkit-scrollbar-track{background:transparent}
#cf .hero{display:grid;grid-template-columns:1.1fr .9fr;gap:18px;padding:38px 22px 30px;align-items:center}
#cf .kick{font-family:var(--font-mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--mut);margin-bottom:16px;display:flex;align-items:center;gap:8px}
#cf .kick .ln{width:26px;height:1px;background:var(--bd)}
#cf .h1{font-size:32px;line-height:1.12;font-weight:500;letter-spacing:-.02em;color:var(--tx);margin:0 0 16px}
#cf .lead{font-size:14px;line-height:1.65;color:var(--mut);max-width:440px;margin:0 0 22px}
#cf .lead b{color:var(--tx);font-weight:500}
#cf .cta{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
#cf .btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:12px;padding:11px 18px;border-radius:9px;cursor:pointer;border:1px solid var(--bl)}
#cf .btn.pri{background:var(--bt);color:#fff;border-color:var(--bt)}#cf .btn.pri:hover{background:#363b41}
#cf .btn.gho{background:transparent;color:var(--mut);border-color:var(--bd)}#cf .btn.gho:hover{color:var(--tx);border-color:var(--bl)}
#cf .meta{margin-top:20px;display:flex;gap:22px;font-family:var(--font-mono);font-size:10px;color:var(--mut)}
#cf .meta b{color:var(--tx);font-weight:500;font-size:15px;display:block;margin-bottom:2px}
#cf .stage{position:relative;display:flex;align-items:center;justify-content:center;min-height:260px}
#cf .ring{position:absolute;border:1px solid var(--bd);border-radius:50%;opacity:.7}
#cf .r1{width:210px;height:210px}#cf .r2{width:160px;height:160px}
#cf .glow{position:absolute;width:160px;height:160px;border-radius:50%;background:radial-gradient(circle,rgba(70,78,86,.10),transparent 68%)}
#cf .slot{position:relative;z-index:2;width:140px;height:170px;border-radius:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px dashed var(--bl);background:var(--s2)}
#cf .slot:hover{border-color:var(--bt)}
#cf .slot.has{border-style:solid}
#cf .slot img{width:100%;height:100%;object-fit:cover}
#cf .slothint{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);font-family:var(--font-mono);font-size:8.5px;color:var(--bt);background:var(--s2);border:1px solid var(--bl);border-radius:6px;padding:3px 8px;white-space:nowrap;display:flex;align-items:center;gap:5px}
#cf .keytag{position:absolute;bottom:30px;right:24px;z-index:3;font-family:var(--font-mono);font-size:9px;color:var(--bt);background:var(--s2);border:1px solid var(--bl);border-radius:6px;padding:4px 8px;letter-spacing:.08em}
#cf .sec{padding:30px 22px;border-top:1px solid var(--bd)}
#cf .sh{font-family:var(--font-mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--mut);margin-bottom:6px}
#cf .st{font-size:20px;font-weight:500;color:var(--tx);letter-spacing:-.01em;margin:0 0 4px}
#cf .ss{font-size:12px;color:var(--mut);max-width:480px;line-height:1.6;margin:0 0 20px}
#cf .what{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}
#cf .wc{background:var(--s1);border:1px solid var(--bd);border-radius:10px;padding:16px 14px}
#cf .wc:hover{border-color:var(--bl)}
#cf .wi{font-size:21px;color:var(--bt);margin-bottom:10px}
#cf .wn{font-size:13px;color:var(--tx);font-weight:500;margin-bottom:4px}
#cf .wd{font-size:11px;color:var(--mut);line-height:1.55}
#cf .frames{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
#cf .frc{background:var(--s1);border:1px solid var(--bd);border-radius:11px;padding:16px 15px 14px;cursor:pointer;transition:border-color .14s,transform .1s;position:relative;overflow:hidden}
#cf .frc:hover{border-color:var(--bt);transform:translateY(-2px)}
#cf .frbadge{position:absolute;top:12px;right:12px;font-family:var(--font-mono);font-size:7.5px;letter-spacing:.08em;color:var(--mut);border:1px solid var(--bd);border-radius:5px;padding:2px 6px}
#cf .fri{font-size:21px;color:var(--bt);margin-bottom:11px}
#cf .frn{font-family:var(--font-mono);font-size:12px;letter-spacing:.05em;color:var(--tx);margin-bottom:5px}
#cf .frd{font-size:10.5px;color:var(--mut);line-height:1.5}
#cf .frgo{margin-top:11px;font-family:var(--font-mono);font-size:9.5px;color:var(--bt);display:flex;align-items:center;gap:5px;opacity:0;transition:opacity .15s}
#cf .frc:hover .frgo{opacity:1}
#cf .alloc{display:flex;border-radius:9px;overflow:hidden;border:1px solid var(--bd);margin-bottom:14px;height:46px}
#cf .sp{display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:var(--font-mono);border-right:1px solid var(--bg)}
#cf .sp:last-child{border-right:0}
#cf .sp .pc{font-size:13px}#cf .sp .pl{font-size:8.5px;margin-top:2px;letter-spacing:.04em}
#cf .splleg{display:flex;gap:18px;flex-wrap:wrap;font-family:var(--font-mono);font-size:10px;color:var(--mut)}
#cf .splleg span{display:flex;align-items:center;gap:6px}#cf .splleg i{width:8px;height:8px;border-radius:2px;display:inline-block}
#cf .econ{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
#cf .ec{background:var(--s1);border:1px solid var(--bd);border-radius:10px;padding:14px}
#cf .ecv{font-family:var(--font-mono);font-size:19px;color:var(--tx);margin-bottom:4px}
#cf .ecl{font-size:11px;color:var(--tx);margin-bottom:2px}
#cf .ecd{font-size:10px;color:var(--mut);font-family:var(--font-mono)}
#cf .stake{background:var(--s1);border:1px solid var(--bl);border-radius:10px;padding:14px 16px;display:flex;align-items:center;gap:14px}
#cf .stake i{font-size:22px;color:var(--am)}
#cf .stake .sk{font-size:12px;color:var(--tx);line-height:1.5}#cf .stake .sk b{color:var(--bt);font-family:var(--font-mono);font-weight:400}
#cf .stake .skd{font-size:10.5px;color:var(--mut);font-family:var(--font-mono);margin-top:3px}
#cf .foot{padding:30px 22px 34px;border-top:1px solid var(--bd);text-align:center}
#cf .foot .fk{font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--mut);margin-bottom:12px}
#cf .foot .fh{font-size:20px;font-weight:500;color:var(--tx);margin:0 0 6px;letter-spacing:-.01em}
#cf .foot .fs{font-size:12px;color:var(--mut);margin-bottom:20px}
#cf .foot .fs a{color:var(--bt);text-decoration:none;cursor:pointer}
#cf .fbar{display:flex;align-items:center;justify-content:space-between;margin-top:28px;padding-top:16px;border-top:1px solid var(--bd);font-family:var(--font-mono);font-size:10px;color:var(--mut)}
</style>
<div id="cf">
  <div class="top">
    <div class="isl"><span style="color:#9aa0a8">[</span> &gt; clone-frame / home <span class="dot"></span></div>
    <div class="modes"><span class="md on" onclick="cfTheme(0)"></span><span class="md" onclick="cfTheme(1)"></span></div>
  </div>
  <div class="nav">
    <div class="brand"><i class="ti ti-cube-3d-sphere" style="color:var(--bt);font-size:16px"></i> CLONE <b>FRAME</b></div>
    <div class="tag"><i></i> building in public</div>
    <div class="nlinks">
      <div class="nl" onclick="cfGo('frames')">Frames</div>
      <div class="nl" onclick="cfGo('econ')">Economy</div>
    </div>
  </div>
  <div class="page" id="cfpage">
    <div class="hero">
      <div class="hcol">
        <div class="kick"><span class="ln"></span> iCLONE · Base 8453</div>
        <h1 class="h1">Automate any tasks with your iCLONE.</h1>
        <p class="lead">Automate, tokenise and sell your <b>iNFT</b> clone.</p>
        <div class="cta">
          <div class="btn pri" onclick="sendPrompt('Entrar nos Frames do CLONE FRAME — abrir o PLAZA FRAME (marketplace de agentes)')"><i class="ti ti-arrow-right"></i> Enter the Frames</div>
          <div class="btn gho" onclick="sendPrompt('Mostrar como criar um agente iCLONE com NFT integrado')"><i class="ti ti-robot"></i> Create an agent</div>
        </div>
        <div class="meta">
          <div><b>iNFT</b>agent with built-in NFT</div>
          <div><b>iCLONE</b>a category of iNFT</div>
          <div><b>Base</b>chain 8453</div>
        </div>
      </div>
      <div class="stage">
        <div class="glow"></div>
        <div class="ring r1"></div><div class="ring r2"></div>
        <div class="slot" id="cfslot" onclick="document.getElementById('cffile').click()">
          <svg id="cfsil" width="120" height="150" viewBox="0 0 100 120"><ellipse cx="50" cy="113" rx="22" ry="5" fill="#5b626a" opacity=".18"/><path d="M28 72 Q26 95 24 113 L76 113 Q74 95 72 72Z" fill="#7b828a" opacity=".55"/><path d="M35 75 Q50 83 65 75 L61 97 Q50 104 39 97Z" fill="#9aa0a7" opacity=".4"/><ellipse cx="50" cy="36" rx="20" ry="22" fill="#3a3f46"/><path d="M30 32 Q32 12 50 10 Q68 12 70 32 Q63 19 50 17 Q37 19 30 32Z" fill="#6b727a"/><ellipse cx="40" cy="38" rx="5" ry="4" fill="#d4d8dd"/><ellipse cx="60" cy="38" rx="5" ry="4" fill="#d4d8dd"/><path d="M68 54 L90 28 L93 31 L71 57Z" fill="#5b626a" opacity=".85"/></svg>
          <div class="slothint"><i class="ti ti-photo-plus" style="font-size:9px"></i> click to set your image</div>
        </div>
        <input type="file" id="cffile" accept="image/*" style="display:none" onchange="cfImg(this)"/>
        <div class="keytag"><i class="ti ti-robot" style="font-size:9px"></i> iCLONE · iNFT #000912</div>
      </div>
    </div>

    <div class="sec" id="sec-what">
      <div class="sh">// what it is</div>
      <h2 class="st">An AI agent, with an NFT built in</h2>
      <p class="ss">An iNFT is an AI automation agent with an integrated NFT — the NFT gives it identity and ownership. iCLONE is one category of iNFT: your automation clone.</p>
      <div class="what">
        <div class="wc"><div class="wi"><i class="ti ti-robot"></i></div><div class="wn">It automates</div><div class="wd">An AI agent that runs your tasks — flows, tools and jobs, on its own.</div></div>
        <div class="wc"><div class="wi"><i class="ti ti-id-badge-2"></i></div><div class="wn">NFT built in</div><div class="wd">The agent carries an integrated NFT — its on-chain identity and ownership.</div></div>
        <div class="wc"><div class="wi"><i class="ti ti-arrows-exchange"></i></div><div class="wn">Yours to trade</div><div class="wd">Held and traded on Base. Own it, automate with it, sell it.</div></div>
      </div>
    </div>

    <div class="sec" id="sec-frames">
      <div class="sh">// the surfaces</div>
      <h2 class="st">Clone Frames</h2>
      <p class="ss">Each surface is a Frame — same terminal, one wallet across all of them.</p>
      <div class="frames">
        <div class="frc" onclick="sendPrompt('Abrir o PLAZA FRAME — marketplace de agentes iCLONE e skills')"><span class="frbadge">marketplace</span><div class="fri"><i class="ti ti-building-store"></i></div><div class="frn">PLAZA FRAME</div><div class="frd">Discover, acquire and trade iCLONE agents and skills. Tiers: rare · superrare · iclone.</div><div class="frgo">open frame <i class="ti ti-arrow-right"></i></div></div>
        <div class="frc" onclick="sendPrompt('Abrir o iCLONE FRAME — criar um agente com NFT integrado (inclui o iNFT Configuration)')"><span class="frbadge">create</span><div class="fri"><i class="ti ti-robot"></i></div><div class="frn">iCLONE FRAME</div><div class="frd">Create your agent and give it a built-in NFT. Includes the iNFT Configuration — image, identity, skills, collection.</div><div class="frgo">open frame <i class="ti ti-arrow-right"></i></div></div>
        <div class="frc" onclick="sendPrompt('Abrir o SKILL FRAME — publicar e adquirir skills em iCLONE token')"><span class="frbadge">skills</span><div class="fri"><i class="ti ti-bolt"></i></div><div class="frn">SKILL FRAME</div><div class="frd">Add skills to an agent — automation, flows and tools. Published from your wallet.</div><div class="frgo">open frame <i class="ti ti-arrow-right"></i></div></div>
      </div>
    </div>

    <div class="sec" id="sec-econ">
      <div class="sh">// how clone frame earns</div>
      <h2 class="st">How the protocol earns</h2>
      <p class="ss">Tools are free. CLONE FRAME earns a thin perpetual royalty on every iNFT resale, and a one-time cut on a skill's first sale.</p>
      <div class="econ">
        <div class="ec"><div class="ecv">5%</div><div class="ecl">Perpetual royalty</div><div class="ecd">on every iNFT resale (2981)</div></div>
        <div class="ec"><div class="ecv">1%</div><div class="ecl">First skill sale</div><div class="ecd">once, never again</div></div>
        <div class="ec"><div class="ecv">$0</div><div class="ecl">Tools</div><div class="ecd">free to build &amp; create</div></div>
      </div>
      <div style="height:26px"></div>
      <div class="sh">// revenue allocation · on-chain</div>
      <h2 class="st">A treasury built for security</h2>
      <p class="ss">Of all the revenue CLONE FRAME earns, 30% compounds on-chain into three reserves — the rest funds development. Every move is auditable and reported.</p>
      <div class="alloc">
        <div class="sp" style="flex:7;background:#e3e6ea"><span class="pc" style="color:#4a4f56">70%</span><span class="pl" style="color:#818790">protocol &amp; development</span></div>
        <div class="sp" style="flex:1;background:#f6e6c9"><span class="pc" style="color:#8a5e12">10%</span><span class="pl" style="color:#8a5e12">BTC</span></div>
        <div class="sp" style="flex:1;background:#d8dce1"><span class="pc" style="color:#565c64">10%</span><span class="pl" style="color:#565c64">VIRT</span></div>
        <div class="sp" style="flex:1;background:#ecdff5"><span class="pc" style="color:#6b3ca0">10%</span><span class="pl" style="color:#6b3ca0">iCLONE</span></div>
      </div>
      <div class="splleg">
        <span><i style="background:#b8841f"></i> BTC — buy &amp; reserve staking</span>
        <span><i style="background:#6b7178"></i> VIRTUALS — reserve staking</span>
        <span><i style="background:#8a52c4"></i> iCLONE — buyback &amp; burn</span>
      </div>
      <div style="height:24px"></div>
      <div class="stake">
        <i class="ti ti-lock-bolt"></i>
        <div><div class="sk">Stake <b>10k iCLONE</b> to publish your own collections — lock 6m, cooldown 1m.</div><div class="skd">ready-made collections need no stake · token launched on the Virtuals launchpad (1B supply)</div></div>
      </div>
    </div>

    <div class="foot">
      <div class="fk">// drops</div>
      <h2 class="fh">Drops to the community</h2>
      <p class="fs">Generate gated drops that unlock access to the CLONE FRAME tools inside <a onclick="sendPrompt('Abrir builtinvenice.ai — hub do ecossistema Venice AI onde o CLONE FRAME está listado')">Venice</a>.</p>
      <div class="cta" style="justify-content:center">
        <div class="btn pri" onclick="sendPrompt('Gerar uma gota (drop) do CLONE FRAME que dá acesso aos tools da CLONE FRAME dentro da Venice (builtinvenice.ai)')"><i class="ti ti-gift"></i> Generate a drop</div>
        <div class="btn gho" onclick="sendPrompt('Entrar nos Frames do CLONE FRAME')"><i class="ti ti-arrow-right"></i> Enter the Frames</div>
      </div>
      <div class="fbar"><span>clone-frame · building in public</span><span>Base · 8453 · iNFT</span></div>
    </div>
  </div>
</div>
<script>
(function(){
  var cf=document.getElementById('cf');
  window.cfTheme=function(d){cf.classList.toggle('dark',!!d);cf.querySelectorAll('.md')[0].classList.toggle('on',!d);cf.querySelectorAll('.md')[1].classList.toggle('on',!!d);};
  window.cfImg=function(inp){
    if(!inp.files||!inp.files[0])return;
    var r=new FileReader();
    r.onload=function(e){
      var s=document.getElementById('cfslot');
      s.classList.add('has');
      s.innerHTML='<img src="'+e.target.result+'"/><div class="slothint"><i class="ti ti-photo-edit" style="font-size:9px"></i> change image</div>';
    };
    r.readAsDataURL(inp.files[0]);
  };
  window.cfGo=function(s){
    var map={frames:'sec-frames',econ:'sec-econ'};
    var el=document.getElementById(map[s]);
    if(el) el.scrollIntoView({behavior:'smooth',block:'start'});
  };
})();
</script>
</div>
